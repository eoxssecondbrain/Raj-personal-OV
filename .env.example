# Copy to .env for local dev (never commit the real .env). On Render, set
# each of these as a service env var / secret instead -- see MANUAL_SETUP.md.

# --- ingestion ---
GOOGLE_SERVICE_ACCOUNT_JSON=   # entire service-account JSON key, single-line string
DRIVE_FOLDER_ID=               # the Drive folder's ID (from its URL)
INGESTION_MAX_ITEMS=20
INGESTION_MAX_SECONDS=600

# --- wiki_writer ---
WIKI_WRITER_MAX_ITEMS=20
WIKI_WRITER_MAX_SECONDS=600
GIT_REMOTE_URL=                # e.g. https://<token>@github.com/<you>/raj-personal-vault.git

# --- mcp_server ---
MCP_URL_TOKEN=                 # long random token; generate with:
                                # python -c "import secrets; print(secrets.token_urlsafe(32))"
PORT=8000

# --- shared ---
ANTHROPIC_API_KEY=             # used by ingestion (image vision calls) and wiki_writer (decision calls)
