# Copy to .env for local dev (never commit the real .env). On Render, set
# each of these as a service env var / secret instead -- see MANUAL_SETUP.md.
#
# All three components (ingestion, wiki_writer, mcp_server) run as ONE
# combined Render service (services/combined/main.py) so they can share one
# persistent disk -- see MANUAL_SETUP.md Section 5 for why.

# --- shared data location ---
VAULT_DATA_ROOT=                # On Render: must equal the disk's mountPath (e.g. /var/data).
                                 # Locally: leave unset -- defaults to the repo root, so
                                 # vault/, raw/, state.db just live in this working tree.

# --- ingestion ---
GOOGLE_SERVICE_ACCOUNT_JSON=   # entire service-account JSON key, single-line string
DRIVE_FOLDER_ID=               # the Drive folder's ID (from its URL)
INGESTION_MAX_ITEMS=20
INGESTION_MAX_SECONDS=600
INGESTION_INTERVAL_MINUTES=240  # combined-service scheduler only; ignored when run standalone

# --- wiki_writer ---
WIKI_WRITER_MAX_ITEMS=20
WIKI_WRITER_MAX_SECONDS=600
WIKI_WRITER_INTERVAL_MINUTES=240  # combined-service scheduler only
WIKI_WRITER_OFFSET_MINUTES=30     # stagger wiki_writer this many minutes after ingestion
GIT_REMOTE_URL=                # e.g. https://<token>@github.com/<you>/raj-personal-vault.git
                                # Required on Render (used to bootstrap-clone VAULT_DATA_ROOT
                                # on first boot, and to push after each wiki_writer run).
                                # Not required locally if VAULT_DATA_ROOT is already a git repo.

# --- mcp_server ---
MCP_URL_TOKEN=                 # long random token; generate with:
                                # python -c "import secrets; print(secrets.token_urlsafe(32))"
PORT=8000

# --- shared ---
ANTHROPIC_API_KEY=             # used by ingestion (image vision calls) and wiki_writer (decision calls)
